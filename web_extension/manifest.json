{
  "manifest_version": 3,
  "name": "洞察织机 InsightLoom 采集",
  "version": "0.1.0",
  "description": "右键一键把网页或选中文字织入洞察织机的 Agent 流水线。",
  "permissions": ["contextMenus", "storage", "notifications", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "洞察织机采集" },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
